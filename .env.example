# Copy to .env.local only when configuring the real installation.
# Empty optional fields keep the app in setup-required mode. Never use admin DB credentials here.
API_HOST=127.0.0.1
API_PORT=4317
DATABASE_URL=
# Restricted runtime login generated by scripts/configure-neon.ts. CLI-managed DATABASE_URL stays setup-only.
ATLAS_DATABASE_URL=
WORKER_DATABASE_URL=
DATABASE_TARGET_ID=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
VITE_NEON_AUTH_URL=
ATLAS_OWNER_ISSUER=
ATLAS_OWNER_SUBJECT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
# DATABASE_URL_UNPOOLED is reserved for separately authorized migrations/backup.
